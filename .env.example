# ═══════════════════════════════════════════════════════════
# DeepSeek LLM 配置（必填）
# ═══════════════════════════════════════════════════════════
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEMPERATURE=0.3

# Docker Compose 数据库（生产环境必须替换）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=deep_research

# ═══════════════════════════════════════════════════════════
# 嵌入模型配置（可选，默认使用本地 BGE 中文模型）
# provider 可选: huggingface | openai | dashscope
# ═══════════════════════════════════════════════════════════
EMBEDDING_PROVIDER=huggingface
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BASE_URL=

# ═══════════════════════════════════════════════════════════
# 多租户 / 会话
# ═══════════════════════════════════════════════════════════
THREAD_ID=default
USER_ID=default_user
TENANT_ID=default_tenant

# ═══════════════════════════════════════════════════════════
# 工作流
# ═══════════════════════════════════════════════════════════
MAX_ITERATIONS=2
# true = 写作后启用 LLM 质量评审（双层质检，额外一次 LLM 调用）
LLM_AS_JUDGE=false

# ═══════════════════════════════════════════════════════════
# 记忆系统
# ═══════════════════════════════════════════════════════════
ENABLE_MEMORY=false
SHORT_TERM_TTL_SECONDS=604800
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_SUMMARY_THRESHOLD=20
SHORT_TERM_BACKEND=postgres
LONG_TERM_BACKEND=postgres
LONG_TERM_SCOPE=user
SAVE_CONVERSATION_TASK=false
CHECKPOINTER_BACKEND=memory
ENABLE_MILVUS=false
MEMORY_TOP_K=6

# ═══════════════════════════════════════════════════════════
# 基础设施连接
# ═══════════════════════════════════════════════════════════
REDIS_URL=
POSTGRES_DSN=
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_COLLECTION=mult_agent_memory

# ═══════════════════════════════════════════════════════════
# 后端服务与安全
# ═══════════════════════════════════════════════════════════
HOST=127.0.0.1
PORT=8000
# 配置后 /api/v1/research/* 需携带 Authorization: Bearer <AUTH_TOKEN>
AUTH_TOKEN=
RATE_LIMIT_PER_MINUTE=30

# ═══════════════════════════════════════════════════════════
# 用量统计（元/百万 token，用于估算单次研究成本）
# ═══════════════════════════════════════════════════════════
DEEPSEEK_INPUT_PRICE_PER_M=1
DEEPSEEK_OUTPUT_PRICE_PER_M=2

# ═══════════════════════════════════════════════════════════
# 其他
# ═══════════════════════════════════════════════════════════
NO_COLOR=
WORKSPACE_DIR=/workspace
